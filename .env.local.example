# TriageAgent — local development environment variables
#
# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored (matched by *.local) — never commit it.
#
# Find these values in your Supabase project:
#   Settings → API → Project URL and Project API keys
#
# IMPORTANT: use only the publishable (anon) key here.
# The secret/service-role key must NEVER appear in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
